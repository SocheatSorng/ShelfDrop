{
  "name": "shelfdrop",
  "version": "0.3.0",
  "private": true,
  "description": "Pick a book from your Google Drive on your Kindle's browser and get it delivered through Send to Kindle.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test \"tests/**/*.test.js\"",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run lint && npm test && npm run audit",
    "token": "node tools/new-token.js",
    "clasp": "npx --yes @google/clasp@3.4.1",
    "clasp:init": "node tools/clasp-deploy.js init",
    "deploy": "node tools/clasp-deploy.js deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
